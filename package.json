{
  "name": "vesika-ben-prensip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BEN PRENSİP — Salim Gümüş manifestosu (Vesika 01). Statik prerender + React adaları.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "fonts:subset": "python3 scripts/subset-fonts.py",
    "make:og": "node scripts/make-og.mjs",
    "make:posts": "node --experimental-strip-types scripts/make-posts.mjs",
    "make:cards": "node --experimental-strip-types scripts/make-posts.mjs --cards",
    "build": "node scripts/prerender.mjs",
    "build:vite": "vite build",
    "size": "node scripts/size-guard.mjs",
    "check": "npm run typecheck && npm run build && npm run size",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
